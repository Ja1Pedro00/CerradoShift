# Copie para .env e ajuste. Nada aqui é obrigatório para subir a API.

# --- Serviço de fórmulas (CerradoShift) --------------------------------------
# Base da API do time de fórmulas. Quando definida, /v1/plan e
# /v1/rotation-options encaminham os dados para ela.
# FORMULAS_BASE_URL=http://localhost:8000
# FORMULAS_FIELD_PATH=/api/v1/assessments/field
# FORMULAS_TRANSITION_PATH=/api/v1/assessments/cerrado-transition-options
FORMULAS_TIMEOUT_SECONDS=30

# --- Cache / rede ------------------------------------------------------------
CACHE_TTL_SECONDS=21600
HTTP_TIMEOUT_SECONDS=25
HTTP_RETRIES=2
# CORS_ORIGINS=*

# --- Credenciais opcionais (fontes que hoje exigem conta) --------------------
# Uma conta Earthdata libera SMAP, GPM/IMERG, ECOSTRESS, GEDI, LP DAAC e AppEEARS.
# Cadastro gratuito: https://urs.earthdata.nasa.gov/users/new
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=

# NASS QuickStats (gratuita): https://quickstats.nass.usda.gov/api
# NASS_API_KEY=

# USDA AMS Market News (gratuita)
# AMS_API_KEY=

# OpenET (gratuita): https://account.etdata.org
# OPENET_API_KEY=

# Copernicus CDS (ERA5)
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=
